{
  "name": "unipept",
  "version": "6.6.0",
  "type": "module",
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "predev": "fantasticon",
    "dev": "vite --host",
    "typecheck": "vue-tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "prebuild": "fantasticon",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest --coverage run",
    "test:e2e": "playwright test",
    "test:record": "node tests/fixtures/api/record.ts",
    "generate-icons": "fantasticon"
  },
  "dependencies": {
    "@mdi/font": "^7.4.47",
    "@vueuse/core": "^15.0.0",
    "d3": "^7.9.2",
    "dompurify": "^3.5.0",
    "html-to-image": "^1.11.13",
    "jszip": "^3.10.1",
    "localforage": "^1.10.0",
    "lru-cache-idb": "^0.5.2",
    "marked": "^18.2.1",
    "peptonizer": "^0.1.28",
    "pinia": "^3.0.4",
    "shared-memory-datastructures": "1.0.0-alpha.9",
    "unipept-visualizations": "^3.0.0",
    "vue": "^3.5.46",
    "vue-router": "^5.5.1",
    "vuedraggable": "^4.1.0",
    "vuetify": "^4.3.4"
  },
  "devDependencies": {
    "fantasticon": "^4.1.0",
    "@mdit-vue/plugin-component": "^4.0.0",
    "@mdit-vue/plugin-frontmatter": "^4.0.0",
    "@mdit-vue/plugin-headers": "^4.0.0",
    "@mdit-vue/plugin-sfc": "^4.0.0",
    "@mdit-vue/plugin-title": "^4.0.0",
    "@mdit-vue/shared": "^4.0.0",
    "@playwright/test": "1.65.1",
    "@shikijs/markdown-it": "^4.6.0",
    "@types/d3": "^7.4.3",
    "@types/markdown-it-container": "^4.0.1",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "^4.1.8",
    "coi-serviceworker": "^0.1.7",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "markdown-it": "^15.0.3",
    "markdown-it-anchor": "^10.1.0",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-container": "^4.0.0",
    "sass": "^1.108.2",
    "shiki": "^4.6.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
